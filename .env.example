DATABASE_URL=postgresql://coordinaite:change-me@localhost:5432/coordinaite
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
APP_ENV=development
# Required: generate with python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use the same secret on every API instance. Never commit the generated value.
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Local frontend and API must both use localhost (or both use 127.0.0.1).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_TIER2=
STRIPE_WEBHOOK_SECRET=
