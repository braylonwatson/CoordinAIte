{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "REACT_APP_API_URL=/api npm run build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hd6jux70ig.execute-api.us-east-1.amazonaws.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
